# URL publica final, sin barra al final
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com.ar

# Numero de WhatsApp en formato internacional, solo digitos (ej. 54911...)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Opcional: identificador de Google Analytics / Ads (ej. G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_TAG_ID=

# Opcional: token de verificacion de Google Search Console
GOOGLE_SITE_VERIFICATION=
